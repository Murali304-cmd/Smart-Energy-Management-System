OPENWEATHER_API_KEY=your_openweather_api_key_here
WEATHER_LAT=13.0827
WEATHER_LON=80.2707

SMART_METER_API_URL=
SMART_METER_API_KEY=
SMART_METER_DEFAULT_ID=METER_TNEB_001

DATABASE_PATH=database/smart_energy.db

TNEB_DATASET_PATH=data/historical/tneb_dataset.csv
ELECTRICITY_TARIFF_PATH=data/historical/electricity_price_tariff.csv

# Real Battery API (Enode Integration)
# Supported modes: real | sandbox | demo
BATTERY_MODE=demo
ENODE_API_URL=https://enode-api.production.enode.io
ENODE_CLIENT_ID=your_enode_client_id_here
ENODE_CLIENT_SECRET=your_enode_client_secret_here
ENODE_BATTERY_ID=your_enode_battery_id_here
ENODE_USER_ID=your_enode_user_id_here
BATTERY_POLL_INTERVAL_SECONDS=15

# Battery Physical Defaults (if not provided by API)
BATTERY_CAPACITY_KWH=20.0
BATTERY_MIN_SOC=20.0
BATTERY_MAX_SOC=100.0
BATTERY_CHARGE_EFFICIENCY=0.95
BATTERY_DISCHARGE_EFFICIENCY=0.95
BATTERY_MAX_CHARGE_KW=5.0
BATTERY_MAX_DISCHARGE_KW=5.0
DESIRED_BACKUP_HOURS=10.0
